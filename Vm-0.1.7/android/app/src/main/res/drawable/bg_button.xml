<!--
  Flat button face: hairline border on paper, one shade darker while pressed.
  A selector, not a ripple image, so there is nothing to inflate and no
  bitmap in the APK.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/paper_dark" />
            <stroke android:width="1dp" android:color="@color/rule" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
            <stroke android:width="1dp" android:color="@color/paper_dark" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
            <stroke android:width="1dp" android:color="@color/rule" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
