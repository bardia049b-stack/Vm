<!--
  Helper key face.  The activated state is the Ctrl latch: the key stays dark
  until the modified character has been sent, which is the only visual state
  change in the whole app.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
            <stroke android:width="1dp" android:color="@color/ink" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rule" />
            <stroke android:width="1dp" android:color="@color/rule" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
            <stroke android:width="1dp" android:color="@color/rule" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
