<!--
  Parented on the *framework* DeviceDefault theme, not Theme.AppCompat.  That
  is what lets android/app/build.gradle.kts have an empty dependencies block.
-->
<resources>
    <style name="RvmTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:navigationBarColor">@color/paper_dark</item>
        <item name="android:statusBarColor">@color/paper_dark</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Flat, small but touchable, no elevation and no ripple animation. -->
    <style name="RvmButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:background">@color/paper</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
